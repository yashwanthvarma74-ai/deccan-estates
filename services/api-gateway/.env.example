DATABASE_URL=postgresql://user:password@localhost:5432/deccan
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Origin allowed to call the API (the web app)
WEB_ORIGIN=https://your-domain.example
# Public address of the API, and of uploaded photos (set to the bucket's public address when using S3_BUCKET)
PUBLIC_UPLOADS_BASE=http://localhost:4000
# Photo storage. Leave S3_BUCKET empty to keep photos on the API's own disk (fine for one server, lost on most free hosts).
# Works with Cloudflare R2, Supabase Storage, AWS S3 or any S3-compatible service.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
